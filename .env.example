# Environment Variables & API Key Configurations

# Federal Reserve Economic Data (FRED) API Key
# Get key from: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# USDA QuickStats API Key
# Get key from: https://quickstats.nass.usda.gov/api
USDA_API_KEY=your_usda_api_key_here

# Copernicus Climate Data Store (CDS) API Credentials (ERA5 Reanalysis)
# Configure via: https://cds.climate.copernicus.eu/api-how-to
CDSAPI_URL=https://cds.climate.copernicus.eu/api/v2
CDSAPI_KEY=your_uid:your_api_key

# Weights & Biases (Experiment Tracking)
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=agriculture-commodity-forecasting
WANDB_ENTITY=your_wandb_username

# Storage / Cache paths (optional override)
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_CACHE_DIR=./data/cache
